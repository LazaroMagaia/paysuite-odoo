<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_paysuite" model="ir.ui.view">
        <field name="name">PaySuite Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'paysuite'">
                    <field name="paysuite_api_token" password="True"/>
                    <field name="paysuite_webhook_secret" password="True"/>
                </group>
            </group>
        </field>
    </record>
</odoo>